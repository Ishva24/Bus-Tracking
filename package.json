{
  "name": "bustrack",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Bus Location Tracking App - Monorepo",
  "workspaces": [
    "packages/*",
    "backend",
    "simulator",
    "mobile"
  ],
  "scripts": {
    "backend": "npm run dev -w backend",
    "simulator": "npm run dev -w simulator",
    "mobile": "npm run start -w mobile",
    "dev": "concurrently \"npm run backend\" \"npm run simulator\"",
    "build": "npm run build -ws",
    "test": "npm run test -ws",
    "lint": "eslint packages/*/src backend/src simulator/src --ext .ts,.tsx",
    "db:migrate": "npm run migrate -w backend",
    "db:seed": "npm run seed -w backend",
    "db:studio": "npm run studio -w backend"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6"
  }
}
